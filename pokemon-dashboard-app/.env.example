# OpenAI API key for the Pokemon AI chatbot
# Get yours at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Optional: choose which model to use (default: gpt-4o-mini)
# Other options: gpt-4o, gpt-4-turbo, gpt-3.5-turbo, o4-mini
OPENAI_MODEL=gpt-4o-mini

# Optional: use a different OpenAI-compatible endpoint (e.g., Azure, LiteLLM)
# OPENAI_BASE_URL=https://api.openai.com/v1
